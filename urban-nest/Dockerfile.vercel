FROM php:8.2-apache

# Install PostgreSQL development libraries
# Required for PDO PostgreSQL / Supabase
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq-dev \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

# Enable Apache modules commonly needed by PHP applications
RUN a2enmod rewrite headers

# Copy the application into Apache's web directory
COPY . /var/www/html/

# Configure Apache for the application
RUN printf '%s\n' \
    '<VirtualHost *:80>' \
    '    DocumentRoot /var/www/html' \
    '    <Directory /var/www/html>' \
    '        AllowOverride All' \
    '        Require all granted' \
    '    </Directory>' \
    '</VirtualHost>' \
    > /etc/apache2/sites-available/urban-nest.conf \
    && a2dissite 000-default.conf \
    && a2ensite urban-nest.conf

# Make Apache/PHP able to access the application files
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

# Start Apache on the port Vercel provides via $PORT (default 80)
RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -e' \
    'PORT="${PORT:-80}"' \
    'sed -i "s/^Listen .*/Listen ${PORT}/" /etc/apache2/ports.conf' \
    'sed -i "s/<VirtualHost \*:80>/<VirtualHost *:${PORT}>/" /etc/apache2/sites-available/urban-nest.conf' \
    'exec apache2-foreground' \
    > /usr/local/bin/start-urban-nest \
    && chmod +x /usr/local/bin/start-urban-nest

# Your application uses port 80
EXPOSE 80

CMD ["/usr/local/bin/start-urban-nest"]
